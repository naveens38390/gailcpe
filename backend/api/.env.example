# MongoDB Atlas connection string. Leave empty to run against an ephemeral
# in-memory instance that seeds itself on boot (development only).
MONGODB_URI=

# Signing key for access tokens. Set this before the API is reachable by
# anyone else — it falls back to a well-known development value.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Password for the single administrator account created by `npm run seed`.
# The email is fixed at jainam@gmail.com.
ADMIN_PASSWORD=

PORT=3000

# Maker-checker. Off by default: this deployment has one administrator, and
# enforcing it would leave every proposal permanently unapprovable. Set to
# true once a second account exists to restore the two-person control across
# master data, price circulars and corrections.
REQUIRE_SEPARATE_APPROVER=false
