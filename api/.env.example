# MongoDB Atlas. Without this the API starts an ephemeral in-process instance so
# the stack can be run locally; nothing persists across restarts.
MONGODB_URI=

# Signing key for access tokens. Required in any deployed environment.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Optional infrastructure. Each has a working in-process fallback so the MVP
# runs before any of it is provisioned:
#   REDIS_URL          -> in-memory cache
#   ELASTICSEARCH_NODE -> MongoDB text indexes
#   S3_BUCKET          -> local filesystem under ./storage
REDIS_URL=
ELASTICSEARCH_NODE=
S3_BUCKET=
AWS_REGION=ap-south-1

PORT=3000
