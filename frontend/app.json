{
  "expo": {
    "name": "GCPE",
    "slug": "gcpe",
    "version": "0.2.0",
    "scheme": "gcpe",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F17"
      },
      "package": "com.gail.gcpe",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#0B0F17"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "primaryColor": "#D92B38",
    "backgroundColor": "#0B0F17",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c31bea6-b844-4323-87fa-1e87811c467d"
      }
    },
    "owner": "beingtharur"
  }
}
